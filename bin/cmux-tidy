#!/usr/bin/env bash
# Project headers (groups) with plain-named tasks under them, one color per project.
# Run it from a cmux tab; safe to rerun. Projects and renames come from ~/.config/cmux/projects.local.json.
[ -z "${CMUX_WORKSPACE_ID:-}" ] && { echo "Run this from a cmux tab." >&2; exit 1; }
CONFIG=~/.config/cmux/projects.local.json
[ -f "$CONFIG" ] || { echo "No $CONFIG yet. Run: just cmux" >&2; exit 1; }

# PROJECTS: name|header folder|color|icon    RULES: title prefix|new title|project|color
PROJECTS=(); RULES=()
while IFS= read -r line; do
  case "$line" in
    P\|*) PROJECTS+=("${line#P|}") ;;
    R\|*) RULES+=("${line#R|}") ;;
  esac
done < <(python3 -c '
import json, os, sys
for name, p in json.load(open(sys.argv[1])).get("projects", {}).items():
    print("P|%s|%s|%s|%s" % (name, os.path.expanduser(p["folder"]), p.get("color", ""), p.get("icon", "")))
    for old, new in p.get("rename", {}).items():
        print("R|%s|%s|%s|%s" % (old, new, name, p.get("color", "")))' "$CONFIG")
[ ${#PROJECTS[@]} -gt 0 ] || { echo "No projects in $CONFIG" >&2; exit 1; }

LIST=$(CMUX_QUIET=1 cmux workspace list --json 2>/dev/null || CMUX_QUIET=1 cmux --json workspace list 2>/dev/null)
PAIRS=$(printf '%s' "$LIST" | python3 -c '
import json,sys
try: data=json.load(sys.stdin)
except Exception: sys.exit(1)
def walk(o):
    if isinstance(o,dict):
        t=next((o[k] for k in ("title","name","customTitle","custom_title") if isinstance(o.get(k),str)),None)
        i=next((o[k] for k in ("ref","id","handle","workspace_ref") if isinstance(o.get(k),str)),None)
        if t and i: print(f"{i}\t{t}")
        for v in o.values(): walk(v)
    elif isinstance(o,list):
        for v in o: walk(v)
walk(data)')
if [ -z "$PAIRS" ]; then
  echo "Could not read the workspace list. Raw output:" >&2
  printf '%s\n' "$LIST" >&2
  exit 1
fi

# Idempotency keys make a rerun reuse the same header instead of adding a second one.
for row in "${PROJECTS[@]}"; do
  IFS='|' read -r pname pdir _ <<<"$row"
  CMUX_QUIET=1 cmux workspace-group create --name "$pname" --cwd "$pdir" --idempotency-key "tidy-$pname" >/dev/null
done
GROUPS_JSON=$(CMUX_QUIET=1 cmux workspace-group list --json)
group_ref() {
  printf '%s' "$GROUPS_JSON" | python3 -c '
import json,sys
want=sys.argv[1]
def walk(o):
    if isinstance(o,dict):
        n=next((o[k] for k in ("name","title") if isinstance(o.get(k),str)),None)
        i=next((o[k] for k in ("ref","id","handle","group_ref") if isinstance(o.get(k),str)),None)
        if n==want and i: print(i); sys.exit(0)
        for v in o.values(): walk(v)
    elif isinstance(o,list):
        for v in o: walk(v)
walk(json.load(sys.stdin))' "$1"
}

for row in "${PROJECTS[@]}"; do
  IFS='|' read -r pname _ pcolor picon <<<"$row"
  gref=$(group_ref "$pname")
  [ -n "$pcolor" ] && CMUX_QUIET=1 cmux workspace-group set-color "$gref" --hex "$pcolor" >/dev/null
  [ -n "$picon" ] && CMUX_QUIET=1 cmux workspace-group set-icon "$gref" --symbol "$picon" >/dev/null
done

while IFS=$'\t' read -r ref title; do
  for rule in "${RULES[@]}"; do
    IFS='|' read -r prefix new label color <<<"$rule"
    case "$title" in
      "$prefix"*)
        CMUX_QUIET=1 cmux workspace-action --action rename --workspace "$ref" --title "$new" >/dev/null
        CMUX_QUIET=1 cmux workspace-group add --group "$(group_ref "$label")" --workspace "$ref" >/dev/null
        CMUX_QUIET=1 cmux workspace-action --action set-color --workspace "$ref" --color "$color" >/dev/null
        echo "OK    $title -> $new ($label)"
        break ;;
    esac
  done
done <<<"$PAIRS"
