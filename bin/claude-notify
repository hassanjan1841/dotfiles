#!/bin/bash
# Claude Code hook: adds a card to the on-screen stack, plus a sound and a macOS banner, when Claude is done or needs you.
# Click a card (or the banner): Herdr opens on the terminal that finished. Skipped when Herdr is already in front.
# Usage in hooks: claude-notify done | needs | clear
kind="${1:-done}"

# A session that starts working again no longer needs its card.
if [ "$kind" = "clear" ]; then
  [ -n "$HC_TERMINAL_ID" ] && rm -f "$HOME/.config/claude-notify/queue/$(printf '%s' "$HC_TERMINAL_ID" | tr -c 'A-Za-z0-9_-' '_').json"
  exit 0
fi

input=$(cat)

front=$(osascript -e 'tell application "System Events" to get bundle identifier of first application process whose frontmost is true' 2>/dev/null)
[ "$front" = "dev.herdr.app" ] && [ -z "$CLAUDE_NOTIFY_FORCE" ] && exit 0

qdir="$HOME/.config/claude-notify/queue"
mkdir -p "$qdir"

# prints "<project>\t<body>" and writes the card file
IFS=$'\t' read -r project body < <(printf '%s' "$input" | KIND="$kind" QDIR="$qdir" python3 -I -c '
import json, os, re, sys, time
try:
    d = json.load(sys.stdin)
except Exception:
    d = {}
kind = os.environ["KIND"]
project = os.path.basename(d.get("cwd", "")) or "claude"
msg = (d.get("message") or "").replace("\n", " ").replace("\t", " ")
terminal = os.environ.get("HC_TERMINAL_ID", "")
title = "Claude needs you" if kind == "needs" else "Claude is done"
body = (msg or "Waiting for your answer") if kind == "needs" else "Finished in " + project
key = re.sub(r"[^A-Za-z0-9_-]", "_", terminal or project)
with open(os.path.join(os.environ["QDIR"], key + ".json"), "w") as f:
    json.dump({"title": title, "project": project, "body": body, "kind": kind, "terminal": terminal, "time": time.time()}, f)
print(project + "\t" + body)
')

bin="$(cd "$(dirname "$0")/../notify-flash" && pwd)"
[ -x "$bin/notify-flash" ] || swiftc -O "$bin/flash.swift" -o "$bin/notify-flash" 2>/dev/null
pgrep -f "notify-flash/notify-flash" >/dev/null || ( nohup "$bin/notify-flash" >/dev/null 2>&1 & )

if [ "$kind" = "needs" ]; then title="Claude needs you"; sound="Sosumi"; else title="Claude is done"; sound="Glass"; fi

go="open -b dev.herdr.app"
[ -n "$HC_TERMINAL_ID" ] && go="$HOME/.local/bin/herdr-app do pane.focus --terminal $HC_TERMINAL_ID; $go"
terminal-notifier -title "$title" -subtitle "$project" -message "$body" \
  -sound "$sound" -group "claude-${HC_TERMINAL_ID:-$project}" -execute "$go" >/dev/null 2>&1

afplay "/System/Library/Sounds/$sound.aiff" >/dev/null 2>&1 &
exit 0
