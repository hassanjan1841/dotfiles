#!/bin/bash
# Claude Code hook. Drops a marker for the Herdr terminal this session runs in; the overlay daemon
# (notify-flash) shows a card only while Herdr says that terminal is finished or blocked.
# Usage in hooks: claude-notify done | needs | clear
# Sessions outside Herdr (no HC_TERMINAL_ID) are ignored: headless runs and background jobs have nowhere to jump to.
kind="${1:-done}"
qdir="$HOME/.config/claude-notify/queue"
key=$(printf '%s' "${HC_TERMINAL_ID:-}" | tr -c 'A-Za-z0-9_-' '_')

# a session that gets a new prompt is working again
if [ "$kind" = "clear" ]; then
  [ -n "$key" ] && rm -f "$qdir/$key.json"
  exit 0
fi

[ -z "$key" ] && exit 0
input=$(cat)
mkdir -p "$qdir"

printf '%s' "$input" | KIND="$kind" QDIR="$qdir" KEY="$key" TERMINAL="$HC_TERMINAL_ID" python3 -I -c '
import json, os, sys, time
try:
    d = json.load(sys.stdin)
except Exception:
    d = {}
kind = os.environ["KIND"]
# "waiting for your input" after a minute of silence is not a request; the finished card already covers it
if kind == "needs" and d.get("notification_type") == "idle_prompt":
    sys.exit(0)
msg = (d.get("message") or "").replace("\n", " ")[:140]
with open(os.path.join(os.environ["QDIR"], os.environ["KEY"] + ".json"), "w") as f:
    json.dump({"terminal": os.environ["TERMINAL"], "kind": kind, "time": time.time(), "message": msg, "cwd": d.get("cwd", "")}, f)
' || exit 0
[ -f "$qdir/$key.json" ] || exit 0

bin="$(cd "$(dirname "$0")/../notify-flash" && pwd)"
[ -x "$bin/notify-flash" ] || swiftc -O "$bin/flash.swift" -o "$bin/notify-flash" 2>/dev/null
pgrep -f "notify-flash/notify-flash" >/dev/null || ( nohup "$bin/notify-flash" >/dev/null 2>&1 & )
exit 0
