#!/bin/bash
# Claude Code hook: macOS banner + sound when Claude is done or needs you, unless Herdr is already in front.
# Usage in hooks: claude-notify done | claude-notify needs
kind="${1:-done}"
input=$(cat)

front=$(osascript -e 'tell application "System Events" to get bundle identifier of first application process whose frontmost is true' 2>/dev/null)
[ "$front" = "dev.herdr.app" ] && exit 0

read -r project message < <(printf '%s' "$input" | python3 -I -c '
import json, os, sys
try:
    d = json.load(sys.stdin)
except Exception:
    d = {}
print(os.path.basename(d.get("cwd", "")) or "claude", (d.get("message") or "").replace("\n", " "))
')

if [ "$kind" = "needs" ]; then
  title="Claude needs you"; sound="Sosumi"; body="${message:-Waiting for your answer}"
else
  title="Claude is done"; sound="Glass"; body="Finished in $project"
fi

terminal-notifier -title "$title" -subtitle "$project" -message "$body" \
  -sound "$sound" -group "claude-$project" -activate dev.herdr.app >/dev/null 2>&1
exit 0
