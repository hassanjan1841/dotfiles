.secrets
*.secrets
.env
.env.*

# Taskwarrior / Timewarrior data (backed up by restic, not git)
taskwarrior/.task/*.data
taskwarrior/.task/*.log
taskwarrior/.timewarrior/data/*
!taskwarrior/.timewarrior/data/.gitkeep

# macOS junk
.DS_Store
**/.DS_Store

# human-input: build artefacts, the source is what is tracked
human-input/human
human-input/Human.app/

# Python bytecode
__pycache__/

# glow: build artefact, built by `just cmux`
glow/glow-overlay

# cmux: personal project rules live in ~/.config/cmux/projects.local.json, never in the repo
cmux/.config/cmux/projects.local.json
