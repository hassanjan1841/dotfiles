{
  "$schema": "https://raw.githubusercontent.com/manaflow-ai/cmux/main/web/data/cmux.schema.json",
  "schemaVersion": 1,
  "app": {
    "warnBeforeClosingWorkspace": true,
    "warnBeforeClosingWindow": true,
    "warnBeforeClosingTab": true,
    "warnBeforeClosingTabXButton": true,
    "confirmQuit": "always"
  },
  "sidebar": {
    "showBranchDirectory": false,
    "showLog": false,
    "showSSH": false,
    "showNotificationMessage": true,
    "notificationMessageLineLimit": 2,
    "wrapWorkspaceTitles": true,
    "showAgentActivity": true,
    "showPorts": true,
    "showPullRequests": false,
    "compactAgentStatus": true
  },
  "workspaceGroups": {
    "byCwd": {
      "~/ehtisham-all-projects/next-shadcn-dashboard-starter-main": { "color": "#7aa2f7", "icon": "building.columns.fill" },
      "~/Passenger-*": { "color": "#ff9e64", "icon": "shippingbox.fill" },
      "~/ehtisham-all-projects/CUSTOMERS*": { "color": "#9ece6a", "icon": "person.2.fill" }
    }
  },
  "automation": {
    "workspaceAutoNaming": true
  }
}
