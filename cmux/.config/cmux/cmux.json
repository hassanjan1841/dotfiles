{
  "$schema": "https://raw.githubusercontent.com/manaflow-ai/cmux/main/web/data/cmux.schema.json",
  "schemaVersion": 1,
  "app": {
    "warnBeforeClosingWorkspace": true,
    "warnBeforeClosingWindow": true,
    "warnBeforeClosingTab": true,
    "warnBeforeClosingTabXButton": true,
    "confirmQuit": "always",
    "accentColor": "#a7b4c6",
    "minimalMode": false,
    "reorderOnNotification": false,
    "sendAnonymousTelemetry": false
  },
  "paneBorderColor": "#222326",
  "activePaneBorderColor": "#3d4350",
  "surfaceTabBar": {
    "fontSize": 12
  },
  "terminal": {
    "autoResumeAgentSessions": false
  },
  "sidebarAppearance": {
    "matchTerminalBackground": false,
    "tintColor": "#101114",
    "tintOpacity": 1
  },
  "workspaceColors": {
    "selectionColor": "#262629",
    "indicatorStyle": "leftRail"
  },
  "sidebar": {
    "fontSize": 13,
    "showBranchDirectory": false,
    "showLog": false,
    "showSSH": false,
    "showNotificationMessage": false,
    "notificationMessageLineLimit": 2,
    "wrapWorkspaceTitles": true,
    "showAgentActivity": true,
    "showPorts": true,
    "showPullRequests": false,
    "compactAgentStatus": true
  },
  "notifications": {
    "paneFlash": false,
    "paneFlashOnTyping": false
  },
  "computerUse": {
    "showInMenuBar": false
  },
  "chief": {
    "enabled": false
  },
  "automation": {
    "workspaceAutoNaming": false,
    "codexIntegration": false,
    "piIntegration": false,
    "ampIntegration": false,
    "cursorIntegration": false,
    "geminiIntegration": false,
    "kiroIntegration": false
  },
  "shortcuts": {
    "bindings": {
      "nextSidebarTab": "cmd+opt+]",
      "prevSidebarTab": "cmd+opt+["
    }
  }
}
