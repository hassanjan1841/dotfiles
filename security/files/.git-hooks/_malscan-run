#!/usr/bin/env bash
# Shared body for the global git hooks. $1 = hook name, $2 = "block"|"warn"
SCAN="$HOME/.security/malscan"
[ -x "$SCAN" ] || exit 0
root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
out=$("$SCAN" --quiet "$root" 2>&1); rc=$?
[ "$rc" = 0 ] && exit 0
printf '\n\033[31m╔════════════════════════════════════════════════════════╗\n'
printf   '║  malscan: SUSPICIOUS CODE DETECTED (%-8s)          ║\n' "$1"
printf   '╚════════════════════════════════════════════════════════╝\033[0m\n'
printf '%s\n\n' "$out"
if [ "$rc" = 2 ]; then
  printf '\033[33mScanner is broken — this is NOT a clean result.\033[0m\n\n'
fi
if [ "$2" = block ]; then
  printf 'Commit blocked. Inspect the file, then re-run.\n'
  printf 'If it is a genuine false positive:  git commit --no-verify\n\n'
  exit 1
fi
printf '\033[33mDo NOT run install/build in this repo until you have checked it.\033[0m\n\n'
exit 0
